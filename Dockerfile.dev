# Single combined development container running the NestJS backend and the Vite frontend
# together as one process group. This is a dev-only shape — production deploys each app as
# its own image (app/backend/Dockerfile, app/frontend/Dockerfile), never combined like this.
#
# No multi-stage "slim runtime" split here on purpose: dev dependencies stay in, and source is
# expected to be bind-mounted over the image for hot-reload rather than baked in permanently.
#
# Debian (glibc), not Alpine (musl): docker-compose.dev.yml bind-mounts the host's own
# node_modules directly, and native addons in those installs are built against the host's
# glibc — an Alpine/musl image can't load them.
FROM node:24-slim

WORKDIR /workspace

RUN npm install -g concurrently

COPY app/backend/package*.json ./app/backend/
COPY app/frontend/package*.json ./app/frontend/
RUN npm --prefix app/backend install
RUN npm --prefix app/frontend install

COPY --chown=node:node app/backend ./app/backend
COPY --chown=node:node app/frontend ./app/frontend

# node:24-slim's built-in "node" user is uid/gid 1000, matching the typical host dev user.
# Running as root here would write build output (dist/, etc.) into the bind-mounted host
# source owned by root, breaking host-side tooling that touches the same files.
USER node

EXPOSE 5000 5173

CMD ["concurrently", "-k", "-n", "backend,frontend", "-c", "blue,yellow", \
  "npm --prefix app/backend run start:dev", \
  "npm --prefix app/frontend run dev"]
