NODE_ENV=development
PORT=3000

LOG_LEVEL=debug,info,warn,error
LOG_DIR=logs

OTEL_ENABLED=true
OTEL_SERVICE_NAME=hakka-backend
# none = trace_id/span_id still populate in logs, but no span JSON is printed anywhere.
# Switch to otlp (with OTEL_EXPORTER_OTLP_ENDPOINT) once a real tracing backend is set up.
OTEL_EXPORTER_TYPE=none
OTEL_EXPORTER_OTLP_ENDPOINT=

CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=false

HELMET_ENABLED=true

DEFAULT_LANGUAGE=en

# Single Postgres database/server hosting both the "hakka" and "ml_forecasts" schemas.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=hakka
DB_SSL=false
DB_LOGGING=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000
