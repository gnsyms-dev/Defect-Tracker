# ==============================================================================
# The ONLY env file in this repo. Everything reads from here.
#
#   - Docker Compose interpolates ${VAR} in docker-compose.yml from this file to
#     provision postgres and choose published host ports, and hands the whole file
#     to the backend container via `env_file:`. Nest then reads its config off the
#     container environment; it never looks for a file in there.
#   - Running the backend on the host, ConfigModule and the sequelize-cli config
#     both resolve ../../.env relative to app/backend, which is this file.
#   - Vite reads it via `envDir` in app/frontend/vite.config.ts (VITE_* only --
#     everything else stays server-side and never reaches the browser bundle).
#     The frontend *container* gets no env file at all; it needs exactly one
#     variable, and docker-compose.yml sets that one directly.
#
# Values marked "container override" are replaced in docker-compose.yml because
# container-to-container networking differs from a host run. They are correct as
# written for running an app directly on the host.
# ==============================================================================

NODE_ENV=development
PORT=5000

LOG_LEVEL=debug,info,warn,error
LOG_DIR=logs

OTEL_ENABLED=true
OTEL_SERVICE_NAME=defect-tracker-backend
# none = trace_id/span_id still populate in logs, but no span JSON is printed anywhere.
# Switch to otlp (with OTEL_EXPORTER_OTLP_ENDPOINT) once a real tracing backend is set up.
OTEL_EXPORTER_TYPE=none
OTEL_EXPORTER_OTLP_ENDPOINT=

CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=false

HELMET_ENABLED=true

# Required, no default: the app refuses to boot without it. Min 32 chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# A full shop-floor shift. Long enough that a supervisor working offline can
# still flush their outbox when connectivity returns.
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

DEFAULT_LANGUAGE=en

# Container override: DB_HOST becomes "postgres" (the compose service name).
DB_HOST=localhost
DB_PORT=5432
# Compose also provisions the postgres container with these three.
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=defect_tracker
DB_SSL=false
DB_LOGGING=true
DB_POOL_MAX=30
DB_POOL_MIN=0
DB_POOL_IDLE_MS=10000

# ------------------------------------------------------------------------------
# Frontend (VITE_* is the only prefix Vite exposes to the browser bundle)
# ------------------------------------------------------------------------------
# Relative by default: dev requests go through Vite's /api proxy to the backend,
# which keeps CORS out of the picture and means testing from a phone on the LAN
# needs no per-device change. Set an absolute URL only for a cross-origin deploy.
VITE_API_BASE_URL=/api/v1
# Where that /api proxy forwards to. Read by the dev server process, not the
# browser. Container override: docker-compose.yml sets http://backend:5000,
# because inside the frontend container "localhost" is the frontend itself.
VITE_API_PROXY_TARGET=http://localhost:5000

# ------------------------------------------------------------------------------
# Docker Compose only -- published host ports
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
# `vite preview` (the production build, service worker included) rather than the dev server.
FRONTEND_PREVIEW_PORT=4173
BACKEND_DEBUG_PORT=9229
